<%= render 'spree/admin/shared/configuration_menu' %>

<% content_for :page_title do %>
  <%= t('spree.editing_currency_rate') %>
<% end %>

<% content_for :page_actions do %>
  <li>
    <%= link_to t('spree.back_to_currency_rates_list'), spree.admin_currency_rates_path, class: 'btn btn-primary' %>
  </li>
<% end %>

<%= render partial: 'spree/shared/error_messages', locals: { target: @currency_rate } %>

<%= form_for [:admin, @currency_rate] do |f| %>
  <fieldset class="no-border-top">
    <%= render partial: 'form', locals: { f: f } %>
    <div class="clear"></div>
    <%= render partial: 'spree/admin/shared/edit_resource_links' %>
  </fieldset>
<% end %>
