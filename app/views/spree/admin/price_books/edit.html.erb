<%= render :partial => 'spree/admin/shared/product_sub_menu' %>

<% content_for :page_title do %>
  <%= t('spree.editing_price_book') %> <span class="green">"<%= @price_book.name %>"</span>
<% end %>

<% content_for :page_actions do %>
  <li>
    <%= link_to t('spree.back_to_price_books_list'), spree.admin_price_books_path, class: 'btn btn-primary' %>
  </li>
<% end %>

<%= render :partial => 'spree/shared/error_messages', :locals => { :target => @price_book } %>

<div id="price_book_form_wrapper">
  <%= form_for [:admin, @price_book] do |f| %>
    <fieldset>
      <%= render :partial => 'form', :locals => { :f => f } %>
      <%= render :partial => 'spree/admin/shared/edit_resource_links' %>
    </fieldset>
  <% end %>
</div>
